{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orca-docs-site-zh",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    // Enable Node.js APIs used by Next.js.
    "nodejs_compat",
    // Required for Server Components fetching public URLs.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "orca-docs-site-zh"
    }
  ]
}
